# Optional for headless automation. Never commit a real API key.
KIRO_API_KEY=

# Optional for official OAuth Authorization Code + PKCE flow.
# These must come from the OAuth provider/app registration.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTH_URL=
OAUTH_TOKEN_URL=
OAUTH_REDIRECT_URI=http://127.0.0.1:8787/callback
OAUTH_SCOPES=offline_access

# Optional provider-specific authorization params, URL query string format.
# Example: access_type=offline&prompt=consent
OAUTH_AUTH_PARAMS=

# Optional local token response store path.
# Defaults to %USERPROFILE%\.kiro-refresh\oauth-tokens.json on Windows.
OAUTH_TOKEN_STORE=
